# ============================================================
# 模型接入配置
#
# 两类 slot：
#   PROVIDER_*  — 通用网关（一个 key 路由多个模型，model name 在 yaml 里设置）
#   MODEL_*     — 专有 API（各模型独立 key + endpoint）
#
# 切换方式：在 config/config.scanners.yaml 和 config/config.generator.yaml 里
#   同时改两个字段：
#     api_key_env:  → 指向目标 slot 的 _KEY
#     base_url_env: → 指向目标 slot 的 _URL
#   以及对应的 model / model_a / model_b / llm_model 字段的值
# ============================================================

# ============================================================
# PROVIDER — 通用网关
# ============================================================

# OpenRouter（路由到 gpt-5-mini / gpt-5 / deepseek 等任意模型）
# PROVIDER_OPENROUTER_KEY=sk-or-v1-your-key-here
# PROVIDER_OPENROUTER_URL=https://openrouter.ai/api/v1

# ============================================================
# MODEL — 专有 API（各模型独立 key）
# ============================================================

# --- DeepSeek 官方 ---
# model name: deepseek-chat | deepseek-reasoner
# MODEL_DEEPSEEK_KEY=sk-your-deepseek-key-here
# MODEL_DEEPSEEK_URL=https://api.deepseek.com/v1

# --- OpenAI 官方 ---
# model name: gpt-4o-mini | gpt-4o | gpt-4-turbo
# MODEL_OPENAI_KEY=sk-proj-your-openai-key-here
# MODEL_OPENAI_URL=https://api.openai.com/v1

# --- 阿里云 DashScope (Qwen) ---
# model name: qwen-plus | qwen-max | qwen-coder-turbo
# MODEL_QWEN_KEY=sk-your-qwen-key-here
# MODEL_QWEN_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 自建代理 ---
# model name: 代理支持的任意模型
# MODEL_PROXY_KEY=your-proxy-key-here
# MODEL_PROXY_URL=https://your-proxy.example.com/v1

# ============================================================
# 专用 scanner（仅需 key，无 provider/model 概念）
# ============================================================
# SNYK_TOKEN=snyk_uat.your-token-here
# VT_API_KEY=your-virustotal-api-key-here

# ============================================================
# 全局控制
# ============================================================
# CLAUDE_CLI_MAX_CONCURRENT=4   # scan_skill_auditor/vetter/slowmist 的并发上限
# VT_RATE_LIMIT_PER_MINUTE=4
# UNIFIED_TIMEOUT=1200
